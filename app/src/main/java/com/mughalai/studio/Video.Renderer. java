
package com.mughalai.studio;

import android.graphics.Canvas;
import android.graphics.Color;
import android.graphics.Paint;
import android.graphics.Typeface;
import android.media.MediaCodec;
import android.media.MediaCodecInfo;
import android.media.MediaFormat;
import android.media.MediaMuxer;
import android.view.Surface;
import java.io.File;
import java.nio.ByteBuffer;

public final class VideoRenderer {

    public interface Progress {
        void update(int frame, int total);
    }

    private static final int W = 1280;
    private static final int H = 720;
    private static final int FPS = 12;

    private VideoRenderer() {}

    public static void render(
            String story,
            File output,
            int minutes,
            boolean english,
            Progress progress) throws Exception {

        if (story == null || story.trim().isEmpty())
            throw new IllegalArgumentException("Story is empty");

        String[] scenes = story.trim().split(
                "\\n\\s*\\n|(?<=[.!?۔])\\s+");

        int total = minutes * 60 * FPS;

        MediaCodec encoder = null;
        MediaMuxer muxer = null;
        Surface surface = null;

        int[] track = {-1};
        boolean[] started = {false};

        try {
            MediaFormat format = MediaFormat.createVideoFormat(
                    MediaFormat.MIMETYPE_VIDEO_AVC, W, H);

            format.setInteger(MediaFormat.KEY_COLOR_FORMAT,
                    MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface);
            format.setInteger(MediaFormat.KEY_BIT_RATE, 2500000);
            format.setInteger(MediaFormat.KEY_FRAME_RATE, FPS);
            format.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 2);

            encoder = MediaCodec.createEncoderByType(
                    MediaFormat.MIMETYPE_VIDEO_AVC);

            encoder.configure(format, null, null,
                    MediaCodec.CONFIGURE_FLAG_ENCODE);

            surface = encoder.createInputSurface();

            muxer = new MediaMuxer(output.getAbsolutePath(),
                    MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4);

            encoder.start();

            MediaCodec.BufferInfo info =
                    new MediaCodec.BufferInfo();

            for (int f = 0; f < total; f++) {

                int index = Math.min(scenes.length - 1,
                        (int)((long)f * scenes.length / total));

                Canvas canvas = surface.lockCanvas(null);

                try {
                    draw(canvas, scenes[index], f, english);
                } finally {
                    surface.unlockCanvasAndPost(canvas);
                }

                drain(encoder, muxer, info, track, started, false);

                if (progress != null && f % FPS == 0) {
                    progress.update(f + 1, total);
                }
            }

            encoder.signalEndOfInputStream();

            drain(encoder, muxer, info, track, started, true);

            if (!started[0]) {
                throw new Exception("Video track was not created");
            }

        } finally {
            if (encoder != null) {
                try { encoder.stop(); } catch (Exception ignored) {}
                try { encoder.release(); } catch (Exception ignored) {}
            }

            if (surface != null) {
                try { surface.release(); } catch (Exception ignored) {}
            }

            if (muxer != null) {
                try {
                    if (started[0]) muxer.stop();
                } catch (Exception ignored) {}

                try { muxer.release(); } catch (Exception ignored) {}
            }
        }
    }

    private static void drain(
            MediaCodec encoder,
            MediaMuxer muxer,
            MediaCodec.BufferInfo info,
            int[] track,
            boolean[] started,
            boolean end) throws Exception {

        boolean eos = false;

        while (!eos) {
            int result = encoder.dequeueOutputBuffer(
                    info, end ? 10000 : 0);

            if (result == MediaCodec.INFO_TRY_AGAIN_LATER) {
                if (!end) return;
                continue;
            }

            if (result == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
                if (started[0])
                    throw new Exception("Format changed twice");

                track[0] = muxer.addTrack(encoder.getOutputFormat());
                muxer.start();
                started[0] = true;

            } else if (result >= 0) {

                ByteBuffer buffer = encoder.getOutputBuffer(result);

                if (buffer != null && started[0] && info.size > 0
                        && (info.flags &
                        MediaCodec.BUFFER_FLAG_CODEC_CONFIG) == 0) {

                    buffer.position(info.offset);
                    buffer.limit(info.offset + info.size);

                    muxer.writeSampleData(track[0], buffer, info);
                }

                eos = (info.flags &
                        MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0;

                encoder.releaseOutputBuffer(result, false);
            }
        }
    }

    private static void draw(
            Canvas c, String caption, int frame, boolean english) {

        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);

        c.drawColor(Color.rgb(112, 174, 222));

        p.setColor(Color.YELLOW);
        c.drawCircle(1080, 110, 54, p);

        p.setColor(Color.rgb(70, 145, 75));
        c.drawRect(0, 520, W, H, p);

        p.setColor(Color.rgb(235, 215, 175));
        c.drawRect(100, 250, 500, 520, p);

        p.setColor(Color.rgb(170, 115, 70));
        c.drawRect(250, 380, 350, 520, p);

        float x = 650 + (float)Math.sin(frame * 0.04) * 35;

        p.setColor(Color.BLACK);
        c.drawCircle(x, 330, 65, p);

        p.setColor(Color.rgb(240, 190, 145));
        c.drawCircle(x, 355, 48, p);

        p.setColor(Color.BLACK);
        c.drawCircle(x - 17, 345, 6, p);
        c.drawCircle(x + 17, 345, 6, p);

        p.setColor(Color.rgb(30, 70, 160));
        c.drawRect(x - 38, 400, x + 38, 520, p);

        p.setColor(Color.argb(215, 0, 0, 0));
        c.drawRoundRect(45, 555, 1235, 690, 22, 22, p);

        p.setColor(Color.WHITE);
        p.setTextSize(34);
        p.setTypeface(Typeface.create(
                "sans-serif", Typeface.BOLD));

        String text = caption == null ? "" : caption.trim();

        if (text.length() > 65)
            text = text.substring(0, 65) + "...";

        p.setTextAlign(
                english ? Paint.Align.CENTER : Paint.Align.RIGHT);

        c.drawText(text, english ? W / 2f : 1190, 635, p);
    }
}
